# odoo-ai-gateway configuration from environment variables, for `docker run --env-file` or
# compose `env_file:`. Used only when no config file is found (ODOO_AI_GATEWAY_CONFIG unset and no
# ./gateway.config.yaml/.yml/.json); a config file always wins.
#
# One variable per line, VAR=value, no quotes around values (docker --env-file keeps them
# literally). An empty variable counts as unset: the default applies. Numbers are plain digits,
# booleans true/false (also 1/0, yes/no).
#
# Entry syntax (tiers, routes, the values of GATEWAY_USAGES):
#   provider:model             openrouter:z-ai/glm-5.2 (split at the first ":", the model may hold ":" and "/")
#   provider:model@effort      openai:gpt-5.6@low (efforts: none, minimal, low, medium, high, xhigh, max)
#   tier name                  fast (routes and usages only)
#   {"provider": ...}          a JSON object: provider, model, effort, name, maxOutputTokens, capabilities, options
#
# The values below are a working minimal example: one OpenRouter-compatible provider with its own
# base URL, two tiers, default and agent routes, and embeddings on an OpenAI-compatible server.
# Replace every "change-me" and the example hosts.

# --- Server ---------------------------------------------------------------------------------
# GATEWAY_HOST=0.0.0.0
# GATEWAY_PORT=8080
# Upper bound for one completion when Odoo sends no `timeout` (seconds).
# GATEWAY_COMPLETION_TIMEOUT_SECONDS=300
# 1/get_completions_sync: Odoo stops waiting after 60 s.
# GATEWAY_SYNC_TIMEOUT_SECONDS=60
# Embeddings, transcription, realtime token (seconds).
# GATEWAY_REQUEST_TIMEOUT_SECONDS=120
# GATEWAY_MAX_BODY_BYTES=67108864

# --- Auth -----------------------------------------------------------------------------------
# Token(s) of the `odoo_ai` IAP account in Odoo (Settings > Technical > IAP > In-App Purchase
# Accounts), comma-separated.
GATEWAY_ACCOUNT_TOKENS=change-me
# Accept any (or no) account token. Only for local development.
# GATEWAY_ALLOW_ANY_ACCOUNT_TOKEN=false
# Signs the realtime `iap_transaction_token` (16 chars or more); random per process when unset.
# GATEWAY_TRANSACTION_TOKEN_SECRET=

# --- Webhook --------------------------------------------------------------------------------
# Hosts allowed as webhook_url, comma-separated (exact host or *.example.com). Unset: any host.
# GATEWAY_WEBHOOK_ALLOWED_HOSTS=odoo.example.com
# GATEWAY_WEBHOOK_MAX_ATTEMPTS=4
# GATEWAY_WEBHOOK_INITIAL_BACKOFF_MS=500
# GATEWAY_WEBHOOK_TIMEOUT_SECONDS=300

# --- Providers ------------------------------------------------------------------------------
# GATEWAY_PROVIDER_<NAME>_API_KEY / _BASE_URL / _HEADERS (a JSON object) for NAME in OPENAI, GROK,
# CLAUDE, GEMINI, OPENROUTER. A provider exists only when its API key is set.
GATEWAY_PROVIDER_OPENROUTER_API_KEY=change-me
GATEWAY_PROVIDER_OPENROUTER_BASE_URL=https://llm.example.com/api/v1
GATEWAY_PROVIDER_OPENROUTER_HEADERS={"X-Title": "Odoo AI Gateway"}
# An OpenAI-compatible embeddings server (e.g. a local inference server); the key is required
# even when the server ignores it.
GATEWAY_PROVIDER_OPENAI_API_KEY=change-me
GATEWAY_PROVIDER_OPENAI_BASE_URL=http://embeddings.internal:8000/v1
# GATEWAY_PROVIDER_CLAUDE_API_KEY=
# GATEWAY_PROVIDER_GEMINI_API_KEY=
# GATEWAY_PROVIDER_GROK_API_KEY=

# --- Tiers ----------------------------------------------------------------------------------
# Tier names, lightest to heaviest. Each one needs GATEWAY_TIER_<NAME> (upper-cased, "-" -> "_")
# holding a target, not a tier name. Odoo's "Think longer" moves a tier job one row up.
GATEWAY_TIERS=fast,deep
GATEWAY_TIER_FAST=openrouter:z-ai/glm-5.2@low
GATEWAY_TIER_DEEP=openrouter:anthropic/claude-opus-5-5@high

# --- Routing --------------------------------------------------------------------------------
# Most specific wins: usages > agent > image generation / web grounding > route > default.
# Required.
GATEWAY_ROUTE_DEFAULT=fast
# Any `agent:*` usage without its own entry.
GATEWAY_ROUTE_AGENT=deep
# GATEWAY_ROUTE_IMAGE_GENERATION=
# GATEWAY_ROUTE_WEB_GROUNDING=
# One variable per gateway route: GATEWAY_ROUTE_GET_COMPLETIONS, GATEWAY_ROUTE_GET_COMPLETIONS_SYNC,
# GATEWAY_ROUTE_GET_EMBEDDINGS, GATEWAY_ROUTE_GET_DEFAULT_EMBEDDING_MODEL,
# GATEWAY_ROUTE_GET_SUPPORTED_EMBEDDING_MODELS, GATEWAY_ROUTE_GET_TRANSCRIPTION,
# GATEWAY_ROUTE_GET_REALTIME_SESSION_TOKEN, GATEWAY_ROUTE_REPORT_REALTIME_SESSION_USAGE.
# Embeddings must have 1536 dimensions; `name` is what Odoo stores (defaults to the model).
GATEWAY_ROUTE_GET_EMBEDDINGS={"provider": "openai", "model": "text-embedding-3-small"}
# GATEWAY_ROUTE_GET_TRANSCRIPTION=openai:whisper-1
# Exact `params.usage` values, one JSON object {usage: entry} (usage keys are not variable names).
# GATEWAY_USAGES={"channel_name": "fast", "agent:ai_website.ai_agent_website_builder": "openrouter:anthropic/claude-sonnet-5-5@medium"}

# --- Embeddings -----------------------------------------------------------------------------
# Older embedding models still accepted: a JSON array of targets or compact entries.
# GATEWAY_EMBEDDINGS_ADDITIONAL=["openai:text-embedding-ada-002"]

# --- Process --------------------------------------------------------------------------------
# LOG_LEVEL=info
# Path of a YAML/JSON config file; when set (or ./gateway.config.yaml exists) these variables are ignored.
# ODOO_AI_GATEWAY_CONFIG=
